<%- include('partials/header') %>

<% if (slides && slides.length > 0) { %>
  <div id="carrosselDestaques" class="carousel slide mb-5" data-bs-ride="carousel">

    <div class="carousel-inner rounded shadow-sm">
      <% slides.forEach((item, i) => { %>
        <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
          <img src="<%= item.imagem %>" alt="<%= item.titulo %>">
          <div class="carousel-caption">
            <h5><%= item.titulo %></h5>
            <p class="d-none d-md-block"><%= item.resumo %></p>
            <a class="btn btn-primary btn-sm" href="/artigo/<%= item._id %>">Ler mais</a>
          </div>
        </div>
      <% }) %>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#carrosselDestaques" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carrosselDestaques" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Próximo</span>
    </button>

  </div>
<% } %>

<h2 class="h4 mb-4">Novidades em Tempo Real (RSS)</h2>
<div class="row g-4">
  <% if (noticiasRss && noticiasRss.length > 0) { %>
    <% noticiasRss.forEach(item => { %>
      <div class="col-md-4">
        <div class="card h-100 shadow-sm card-noticia">
          <div class="card-body d-flex flex-column">
            <h5 class="card-title fs-6"><%= item.title %></h5>
            <p class="card-text text-muted small flex-grow-1"><%= item.contentSnippet %></p>
            <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener" href="<%= item.link %>">Ler mais</a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p class="text-muted">Feed indisponível no momento.</p>
  <% } %>
</div>

<%- include('partials/footer') %>
